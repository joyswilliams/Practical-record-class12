Question:
A web browser stores the recently visited web pages in a stack. Write a Python program using a list to implement the following operations:
Visit a new webpage – PUSH
Go back to the previous webpage – POP
Display the current webpage – PEEK
history = []

def visit():
    page = input("Enter webpage URL: ")
    history.append(page)
    print("Page visited:", page)

def back():
    if len(history) == 0:
        print("No previous page available.")
    else:
        print("Going back from:", history.pop())

def current_page():
    if len(history) == 0:
        print("No webpage available.")
    else:
        print("Current webpage:", history[-1])

while True:
    print("\nBROWSER HISTORY")
    print("1. Visit Page")
    print("2. Back")
    print("3. Current Page")
    print("4. Exit")

    ch = int(input("Enter choice: "))

    if ch == 1:
        visit()
    elif ch == 2:
        back()
    elif ch == 3:
        current_page()
    elif ch == 4:
        break
    else:
        print("Invalid choice!")
