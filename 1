1.Write a Python program to create a text file named story.txt, write a few lines entered by the user into it, and then read and display the contents of the file on the screen.

def create_file():

with open("story.txt", "w") as file:

print("Enter 3 lines of text:")

for i in range(3):

line = input(f"Line {i+1}: ")

file.write(line + "\n")

print("File written successfully!\n")

def read_file():

print("--- Contents of story.txt ---")

with open("story.txt", "r") as file:

content = file.read()

print(content)

# Main Execution

create_file()

read_file()
